{
  "expo": {
    "name": "FoodieDeals Restaurant",
    "slug": "foodiedeals-restaurant",
    "scheme": "foodiedeals-restaurant",
    "version": "0.1.0",
    "orientation": "landscape",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F3EE",
    "icon": "./assets/icon.png",
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foodiedeals.restaurant"
    },
    "android": {
      "package": "com.foodiedeals.restaurant",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC53D"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "9a57e1d9-ae27-4a7f-816a-469f32d8fbaa"
      }
    },
    "owner": "alidev5",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9a57e1d9-ae27-4a7f-816a-469f32d8fbaa"
    }
  }
}
