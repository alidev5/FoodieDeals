{
  "expo": {
    "name": "FoodieDeals",
    "slug": "foodiedeals-customer",
    "scheme": "foodiedeals",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "backgroundColor": "#F7F3EE",
    "icon": "./assets/icon.png",
    "plugins": ["expo-router", "expo-secure-store", "./plugins/withoutStripePushProvisioning"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.foodiedeals.customer"
    },
    "android": {
      "package": "com.foodiedeals.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC53D"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "origin": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bff52a1c-14dd-4710-89f4-2feb8569d100"
      }
    },
    "owner": "alidev5",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bff52a1c-14dd-4710-89f4-2feb8569d100"
    }
  }
}
