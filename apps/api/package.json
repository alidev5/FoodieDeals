{
  "name": "@foodiedeals/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/node.ts",
    "start": "tsx --env-file=.env src/node.ts",
    "bundle": "tsx scripts/bundle-edge.ts",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --dir src",
    "test:e2e": "vitest run --dir test --no-file-parallelism",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "seed:sql": "tsx scripts/generate-seed-sql.ts",
    "stripe:setup": "tsx --env-file=.env scripts/stripe-setup.ts",
    "webhook:dev-test": "tsx --env-file=.env scripts/send-test-webhook.ts",
    "payouts:mark-paid": "tsx --env-file=.env scripts/mark-paid-out.ts"
  },
  "dependencies": {
    "@foodiedeals/shared": "workspace:*",
    "@hono/node-server": "1.14.4",
    "hono": "4.7.11",
    "postgres": "3.4.7",
    "stripe": "^17.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "esbuild": "0.25.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
